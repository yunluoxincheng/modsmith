{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modsmith.local/schemas/profiles/forge-1.20.1.schema.json",
  "title": "ModSmith Target Profile: Forge 1.20.1",
  "allOf": [
    {
      "$ref": "../modspec.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "target": {
          "type": "object",
          "required": [
            "loader",
            "minecraftVersion",
            "loaderVersion",
            "javaVersion",
            "targetProfile",
            "mappings"
          ],
          "properties": {
            "loader": {
              "const": "forge"
            },
            "minecraftVersion": {
              "const": "1.20.1"
            },
            "loaderVersion": {
              "type": "string",
              "pattern": "^47\\.[0-9]+\\.[0-9]+$"
            },
            "javaVersion": {
              "const": 17
            },
            "targetProfile": {
              "const": "forge-1.20.1"
            },
            "mappings": {
              "type": "object",
              "required": [
                "channel",
                "version"
              ],
              "properties": {
                "channel": {
                  "const": "official"
                },
                "version": {
                  "const": "1.20.1"
                }
              }
            }
          }
        },
        "loaderExtensions": {
          "type": "object",
          "properties": {
            "forge": {
              "type": "object",
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
